{
  "name": "grepmax",
  "version": "0.26.26",
  "author": "Robert Owens <78518764+reowens@users.noreply.github.com>",
  "homepage": "https://github.com/reowens/grepmax",
  "bugs": {
    "url": "https://github.com/reowens/grepmax/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reowens/grepmax.git"
  },
  "main": "dist/index.js",
  "bin": {
    "gmax": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "prebuild": "rm -rf dist tsconfig.tsbuildinfo && mkdir -p dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "npx tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:recall": "npx tsx src/eval.ts",
    "bench:recall:json": "GMAX_EVAL_JSON=1 npx tsx src/eval.ts",
    "bench:oss": "npx tsx src/eval-oss.ts all",
    "bench:oss:json": "GMAX_EVAL_JSON=1 npx tsx src/eval-oss.ts all",
    "bench:tokens": "npx tsx src/eval-tokens.ts",
    "bench:tokens:json": "GMAX_EVAL_JSON=1 npx tsx src/eval-tokens.ts",
    "bench:surprises": "npx tsx src/eval-surprising-connections.ts",
    "bench:surprises:json": "GMAX_EVAL_JSON=1 npx tsx src/eval-surprising-connections.ts",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc -p tsconfig.tests.json",
    "prepublishOnly": "pnpm run test:typecheck && pnpm build",
    "preversion": "pnpm test && pnpm typecheck && pnpm run test:typecheck && pnpm run format:check",
    "version": "bash scripts/sync-versions.sh && git add -A",
    "postversion": "bash scripts/postrelease.sh"
  },
  "keywords": [
    "grepmax",
    "grep",
    "search",
    "semantic-search",
    "code-search",
    "code-intelligence",
    "embeddings",
    "vector-search",
    "rag",
    "mcp",
    "claude-code",
    "coding-agent",
    "ai-agent",
    "llm",
    "call-graph",
    "tree-sitter",
    "lancedb",
    "cli"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "plugins",
    "scripts/postinstall.js",
    "mlx-embed-server",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "license": "Apache-2.0",
  "description": "Semantic code search for coding agents. Local embeddings, LLM summaries, call graph tracing.",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "0.38.0-beta.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@parcel/watcher": "^2.6.0",
    "apache-arrow": "^18.1.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.8",
    "lmdb": "^3.5.6",
    "numkong": "^7.8.2",
    "onnxruntime-node": "1.24.3",
    "openai": "^6.45.0",
    "ora": "^9.4.1",
    "proper-lockfile": "^4.1.2",
    "uuid": "^14.0.2",
    "web-tree-sitter": "^0.26.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.4.1",
    "@types/proper-lockfile": "^4.1.4",
    "node-gyp": "^13.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
